# Copy this file to .env for local development.
# Never commit a real .env file — it is already git-ignored.

# --- LLM provider ---
LLM_PROVIDER=openrouter

# OpenRouter (recommended): https://openrouter.ai/settings/keys
# Comma-separate multiple keys for automatic failover on rate limits.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_KEYS=key-one,key-two,key-three
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional secondary providers (not required)
# GROQ_API_KEY=
# GROQ_API_KEYS=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Storage ---
STORAGE_ROOT=./backend/storage
UPLOAD_FOLDER=./backend/storage/uploads
MAX_FILE_SIZE_MB=25

# --- Chunking / retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# --- Summarization ---
SUMMARY_MAX_LENGTH=500
AUTO_SUMMARIZE=true

# --- Standalone FastAPI backend (optional, not used by the Streamlit app) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
